generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  phone     String?
  address   String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id              Int      @id @default(autoincrement())
  companyName     String   @default("Prime Watch Security")
  logo            String   @default("/assets/img/logo.svg")
  favicon         String   @default("/favicon.ico")
  contactEmail    String   @default("info@primewatch.co.ke")
  phoneNumbers    String   @default("+254 700 000000")
  officeLocation  String   @default("Nairobi, Kenya")
  facebookUrl     String?
  twitterUrl      String?
  instagramUrl    String?
  pinterestUrl    String?
  heroTitle       String   @default("Your Safety, Our Priority")
  heroSubtitle    String   @default("Comprehensive security solutions tailored for your peace of mind.")
  heroBtnText     String   @default("Get Protected Today")
  footerContent   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Page {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  icon        String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Blog {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  excerpt       String?  @db.VarChar(280)
  content       String   @db.Text
  featuredImage String?
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  createdAt DateTime @default(now())
}

// ─── SalesOps Models ───────────────────────────────────────────────

model SalesCustomer {
  id          Int         @id @default(autoincrement())
  name        String
  industry    String?
  type        String      @default("Starter")
  location    String?
  email       String?
  phone       String?
  revenue     Float       @default(0)
  healthScore Int         @default(50)
  initials    String?
  color       String?
  lastContact String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deals       SalesDeal[]
}

model SalesDeal {
  id         Int            @id @default(autoincrement())
  company    String
  contact    String?
  email      String?
  value      Float          @default(0)
  stage      String         @default("Lead")
  status     String         @default("Pending")
  rep        String?
  closeDate  DateTime?
  notes      String?        @db.Text
  customerId Int?
  customer   SalesCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model SalesTeamMember {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?
  role      String?
  initials  String?
  color     String?
  territory String?
  deals     Int       @default(0)
  revenue   Float     @default(0)
  growth    String?
  joinDate  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SalesActivity {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  body      String?  @db.Text
  dealId    Int?
  customerId Int?
  rep       String?
  createdAt DateTime @default(now())
}
